@using Rag.Blazor.Models
@using Rag.Blazor.State
@using Rag.Blazor.Services
@using Microsoft.JSInterop
@inject StreamingClient StreamingClient
@inject ChatState ChatState
@inject AuthService AuthService
@inject IJSRuntime JSRuntime
@inject UiSettings UiSettings
@implements IDisposable

<div class="chat-layout">

    <ChatSidebar OnNewChat="HandleNewChat" />

    <div class="chat-main">

        @if (!AuthService.IsAuthenticated)
        {
            <!-- Ekran logowania w centrum -->
            <div class="auth-center">
                <div class="auth-center-content">
                    <p class="auth-description">Sign in with Google to start chatting and save your conversation history</p>
                    <div id="google-signin-button-center" class="google-signin-center"></div>
                </div>
            </div>
        }
        else if (ChatState.Messages.Count == 0)
        {
            <div class="chat-input-wrapper centered">
                <div class="welcome-text">Local Knowledge Assistant</div>
                <ChatInput OnSend="HandleSend" />
            </div>
        }
        else
        {
            <div class="chat-container" id="chatContainer">
                <div class="chat-messages">
                    @foreach (var msg in ChatState.Messages)
                    {
                        <ChatMessage Message="msg" />
                    }

                    @if (ChatState.IsLoading)
                    {
                        <div class="typing-indicator">
                            <span>AI is typing</span>
                            <span class="typing-dots">
                                <span class="dot">.</span>
                                <span class="dot">.</span>
                                <span class="dot">.</span>
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="chat-input-wrapper">
                <div style="max-width: 768px; margin: 0 auto; width: 100%;">
                    <ChatInput OnSend="HandleSend" />
                </div>
            </div>
        }

    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += OnAuthStateChanged;
        ChatState.OnStateChanged += OnChatStateChanged;
    }

    private void OnAuthStateChanged()
    {
        StateHasChanged();
    }

    private async void OnChatStateChanged()
    {
        StateHasChanged();
        await ScrollToBottom();
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
        ChatState.OnStateChanged -= OnChatStateChanged;
    }
    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(UiSettings.ScrollDelay);
            await JSRuntime.InvokeVoidAsync("scrollToBottom");
        }
        catch
        {
            // Ignore errors if element not yet rendered
        }
    }

    private static bool IsPunctuation(char c)
    {
        return c is '.' or ',' or '!' or '?' or ';' or ':' or ' ';
    }

    private void HandleNewChat()
    {
        ChatState.Messages.Clear();
        ChatState.ConversationId = null;
        ChatState.IsLoading = false;
        StateHasChanged();
    }

    private async Task HandleSend(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return;

        ChatState.AddUserMessage(text);

        ChatState.IsLoading = true;

        var botMessage = new ChatMessageModel
        {
            IsUser = false,
            Text = ""
        };

        ChatState.Messages.Add(botMessage);

        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await foreach (var chunk in StreamingClient.StreamAsync(
                               text,
                               ChatState.ConversationId))
            {
                if (chunk.IsConversationId)
                {
                    ChatState.ConversationId = chunk.ConversationId;
                    continue;
                }

                if (chunk.IsCitations)
                {
                    botMessage.Sources = chunk.Sources;
                    StateHasChanged();
                    continue;
                }

                if (chunk.IsCompleted)
                {
                    break;
                }

                // Dodaj token
                if (!string.IsNullOrEmpty(chunk.Content))
                {
                    botMessage.Text += chunk.Content;
                    StateHasChanged();
                    
                    // Opóźnienie dla lepszego efektu wizualnego
                    await Task.Delay(UiSettings.StreamingDelay);
                    await ScrollToBottom();
                }
            }
        }
        catch (Exception ex)
        {
            botMessage.Text = $"Error: {ex.Message}";
        }
        finally
        {
            ChatState.IsLoading = false;
            StateHasChanged();
            
            // Powiadom o aktualizacji konwersacji (dla odświeżenia listy)
            ChatState.NotifyConversationUpdated();
        }
    }
}