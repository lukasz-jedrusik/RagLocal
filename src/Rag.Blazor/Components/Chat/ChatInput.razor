@using Rag.Blazor.Services
@inject AuthService AuthService

<div class="chat-input-container">

    <textarea class="chat-input"
              @bind="Input"
              @bind:event="oninput"
              @onkeydown="HandleKeyDown"
              placeholder="@GetPlaceholder()"
              rows="1"
              disabled="@(!AuthService.IsAuthenticated)"></textarea>

    <button class="send-button"
            @onclick="SendMessage"
            disabled="@(!AuthService.IsAuthenticated || string.IsNullOrWhiteSpace(Input))"
            title="@GetButtonTitle()">
        Send
    </button>

</div>

@code {

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    private string Input { get; set; } = string.Empty;

    private string GetPlaceholder()
    {
        return AuthService.IsAuthenticated 
            ? "Message Knowledge Assistant..." 
            : "Please sign in to chat...";
    }

    private string GetButtonTitle()
    {
        if (!AuthService.IsAuthenticated)
            return "Please sign in to send messages";
        
        return string.IsNullOrWhiteSpace(Input) 
            ? "Type a message to send" 
            : "Send message";
    }

    private async Task SendMessage()
    {
        if (!AuthService.IsAuthenticated || string.IsNullOrWhiteSpace(Input))
            return;

        var message = Input;
        Input = string.Empty;

        await OnSend.InvokeAsync(message);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!AuthService.IsAuthenticated)
            return;

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }
}